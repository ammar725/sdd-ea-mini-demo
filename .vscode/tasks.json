{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SDD: Check architecture",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["arch.py", "check"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false },
      "problemMatcher": []
    },
    {
      "label": "SDD: Reset demo to start",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["arch.py", "reset"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "SDD: Load finished solution (fallback)",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["arch.py", "solution"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
